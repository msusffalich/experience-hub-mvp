{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "20",
    "python": "3.12"
  },
  "steps": {
    "build": {
      "commands": [
        "...",
        "python -m pip install --target ./.python -r requirements.txt",
        "PYTHONPATH=./.python python -c \"import reportlab; print('ReportLab ready', reportlab.Version)\""
      ]
    }
  }
}
