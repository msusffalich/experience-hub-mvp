NODE_ENV=production
PORT=5174
HOST=0.0.0.0

# Production persistence. Use Supabase so desktop, mobile, and tablet share the same data.
STORAGE_ADAPTER=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-service-role-key
SUPABASE_STORAGE_BUCKET=experience-media

# Keep local fallback deterministic. Real users are identified by Supabase Auth.
LOCAL_USER_ID=00000000-0000-0000-0000-000000000001

# External context and AI features.
CONTEXT_TIMEOUT_MS=12000
DEFAULT_OPERATIONAL_LOCATION="Winter Garden, Florida"
EMBEDDINGS_PROVIDER=local-hash
EMBEDDING_DIMENSIONS=384
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
TRANSCRIPTION_PROVIDER=none
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Native/mobile realtime voice. Prefer a dedicated key for cost and safety isolation;
# if omitted, the server falls back to OPENAI_API_KEY.
OPENAI_REALTIME_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TOKEN_TIMEOUT_MS=12000
OPENAI_REALTIME_MAX_SESSION_MINUTES=10

# Optional Arnes orchestration service for Vibeapp assistant calls.
ARNES_ASSISTANT_ENABLED=false
ARNES_ASSISTANT_URL=
ARNES_ASSISTANT_TIMEOUT_MS=15000
VIBE_BACKEND_BASE_URL=https://experience-hub-web-production.up.railway.app

# Optional Obsidian vault export. In Railway this should point to a persistent volume
# if you want server-side Markdown files to survive redeploys.
OBSIDIAN_VAULT_PATH=./obsidian-vault-vibe

# Cartelera de cines (peliculas en cartel, con poster). Clave gratuita de TMDB:
# https://www.themoviedb.org/settings/api  -> "API Key (v3 auth)"
# Sin ella la seccion de cartelera lo dice explicitamente en vez de quedar vacia.
TMDB_API_KEY=
