{
  "name": "experience-hub-mvp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/install-python-deps.mjs",
    "verify:pdf": "node scripts/verify-reportlab.mjs",
    "verify:outputs": "node scripts/verify-output-pdfs.mjs",
    "verify:pwa": "node scripts/verify-pwa-release.mjs",
    "verify:android": "node scripts/verify-android-release.mjs",
    "verify:release": "npm run check && npm run verify:outputs && npm run verify:pwa",
    "start": "node server.js",
    "dev": "node server.js",
    "check": "node --check app.js && node --check server.js && node scripts/smoke-check.mjs",
    "test": "npm run check"
  }
}
