PORT=5174
HOST=127.0.0.1
STORAGE_ADAPTER=json-file

# Set STORAGE_ADAPTER=supabase to use Supabase via PostgREST.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-service-role-key
SUPABASE_STORAGE_BUCKET=experience-media

# MVP local profile used until Supabase Auth is added.
LOCAL_USER_ID=00000000-0000-0000-0000-000000000001

# External context analysis: weather via Open-Meteo and news via GDELT.
CONTEXT_TIMEOUT_MS=6500
DEFAULT_OPERATIONAL_LOCATION="Winter Garden, Florida"

# Semantic search embeddings. Default local-hash is free/offline and compatible with pgvector(384).
# Set EMBEDDINGS_PROVIDER=openai plus OPENAI_API_KEY to generate model embeddings.
EMBEDDINGS_PROVIDER=local-hash
EMBEDDING_DIMENSIONS=384
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional backend transcription for long audio.
TRANSCRIPTION_PROVIDER=none
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Optional native/mobile realtime voice token minting.
OPENAI_REALTIME_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TOKEN_TIMEOUT_MS=12000
OPENAI_REALTIME_MAX_SESSION_MINUTES=10

# Optional Arnes orchestration service for Vibeapp assistant calls.
ARNES_ASSISTANT_ENABLED=false
ARNES_ASSISTANT_URL=
ARNES_ASSISTANT_TIMEOUT_MS=15000
VIBE_BACKEND_BASE_URL=https://experience-hub-web-production.up.railway.app

# Optional Obsidian vault export. If omitted, the backend uses ./obsidian-vault-vibe.
OBSIDIAN_VAULT_PATH=./obsidian-vault-vibe
